    "test:adversarial": "node run_all_tests.js --filter=adversarial",
    "test:integration": "node run_all_tests.js --filter=integration"
  },
  "keywords": [
    "amm",
    "tests",
    "fuzzing",
    "invariants",
    "adversarial",
    "qmoosa"
  ],
  "author": "elon00",
