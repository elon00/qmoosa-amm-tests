{
  "name": "@qmoosa/amm-tests",
  "version": "1.0.0",
  "description": "Adversarial test suite, fuzzing harness, regression gates, and automated CI for Qmoosa AMM",
  "scripts": {
    "test": "node run_all_tests.js",
    "test:invariants": "node run_all_tests.js --filter=invariants",
